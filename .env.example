# Vibi backend environment
# Copy to .env and fill in real values. NEVER put real keys in this file — it is committed to git.
PORT=3030

# Shared secret the Android app sends as "Authorization: Bearer <token>" on /api requests.
# Required in production (the Docker image refuses to start without it).
# Generate one with: openssl rand -hex 32
# and put the same value in android/local.properties as TRIPWEAVE_API_TOKEN.
API_TOKEN=

# OpenAI API Key (used for Whisper audio transcription & Vision OCR in media-worker)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Google Places & Routes API Key (used for place resolving & travel time solver)
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Supabase (service role is backend-only — never ship it in the APK)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Free-tier guard: estimated OpenAI spend allowed per month (USD). The app warns at 50% and 80%;
# new AI calls stop at 90% until the next month.
OPENAI_MONTHLY_BUDGET_USD=5

# Optional: change Google's free calls per SKU if your quota differs, as JSON, e.g.
# GOOGLE_FREE_CAPS={"place_photos":1000,"text_search_pro":5000}
GOOGLE_FREE_CAPS=

# Imports analyzed at the same time; the rest wait in line.
MAX_CONCURRENT_IMPORTS=2
